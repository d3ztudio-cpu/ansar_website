{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/science-labs{,/**}",
        "destination": "/learning/advanced-labs",
        "type": 301
      },
      {
        "source": "/learning/wi-fi-learning-environment{,/**}",
        "destination": "/learning/smart-classrooms",
        "type": 301
      },
      {
        "source": "/events/6",
        "destination": "/events",
        "type": 301
      },
      {
        "source": "/staff{,/**}",
        "destination": "/about",
        "type": 301
      },
      {
        "source": "/leadership{,/**}",
        "destination": "/#leadership",
        "type": 301
      },
      {
        "source": "/event{,/**}",
        "destination": "/events",
        "type": 301
      },
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/index-new.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/about.html",
        "destination": "/about",
        "type": 301
      },
      {
        "source": "/about-new.html",
        "destination": "/about",
        "type": 301
      },
      {
        "source": "/academics.html",
        "destination": "/academics",
        "type": 301
      },
      {
        "source": "/admission.html",
        "destination": "/admission",
        "type": 301
      },
      {
        "source": "/admission-new.html",
        "destination": "/admission",
        "type": 301
      },
      {
        "source": "/contact.html",
        "destination": "/contact",
        "type": 301
      },
      {
        "source": "/contact-new.html",
        "destination": "/contact",
        "type": 301
      },
      {
        "source": "/gallery-page.html",
        "destination": "/gallery",
        "type": 301
      },
      {
        "source": "/events.html",
        "destination": "/events",
        "type": 301
      },
      {
        "source": "/events-page.html",
        "destination": "/events",
        "type": 301
      },
      {
        "source": "/news.html",
        "destination": "/news",
        "type": 301
      },
      {
        "source": "/news-page.html",
        "destination": "/news",
        "type": 301
      },
      {
        "source": "/news-detail.html",
        "destination": "/news",
        "type": 301
      },
      {
        "source": "/admin.html",
        "destination": "/admin",
        "type": 301
      },
      {
        "source": "/:path*/",
        "destination": "/:path",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/@(index.html|sw.js|version.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(avif|webp|png|jpg|jpeg|gif|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "**/*.@(pdf|xlsx|xls)",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, follow, noarchive"
          }
        ]
      },
      {
        "source": "/admin{,/**}",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow, noarchive"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/admin{,/**}",
        "destination": "/index.html"
      },
      { "source": "/learning/cctv-enabled-safety", "destination": "/seo/learning/cctv-enabled-safety.html" },
      { "source": "/learning/smart-classrooms", "destination": "/seo/learning/smart-classrooms.html" },
      { "source": "/learning/qualified-support-staff", "destination": "/seo/learning/qualified-support-staff.html" },
      { "source": "/learning/special-play-area", "destination": "/seo/learning/special-play-area.html" },
      { "source": "/learning/advanced-labs", "destination": "/seo/learning/advanced-labs.html" },
      { "source": "/learning/multi-sports-play-area", "destination": "/seo/learning/multi-sports-play-area.html" },
      { "source": "/learning/safe-school-transport", "destination": "/seo/learning/safe-school-transport.html" },
      { "source": "/learning/healthy-dining-spaces", "destination": "/seo/learning/healthy-dining-spaces.html" },
      {
        "source": "/@(news|events|achievements|sports-achievements)/**",
        "destination": "/index.html"
      },
      {
        "source": "/library/quiz",
        "destination": "/index.html"
      },
      {
        "source": "/ansar-sprouts/activities/:id",
        "destination": "/index.html"
      },
      {
        "source": "/alumni/:section/:index",
        "destination": "/index.html"
      },
      { "source": "/about", "destination": "/seo/about.html" },
      { "source": "/academics", "destination": "/seo/academics.html" },
      { "source": "/admission", "destination": "/seo/admission.html" },
      { "source": "/news", "destination": "/seo/news.html" },
      { "source": "/events", "destination": "/seo/events.html" },
      { "source": "/contact", "destination": "/seo/contact.html" },
      { "source": "/gallery", "destination": "/seo/gallery.html" },
      { "source": "/sports-page", "destination": "/seo/sports-page.html" },
      { "source": "/atl", "destination": "/seo/atl.html" },
      { "source": "/library", "destination": "/seo/library.html" },
      { "source": "/ansar-sprouts", "destination": "/seo/ansar-sprouts.html" },
      { "source": "/field-trips", "destination": "/seo/field-trips.html" },
      { "source": "/extension-services", "destination": "/seo/extension-services.html" },
      { "source": "/life-at-ansar", "destination": "/seo/life-at-ansar.html" },
      { "source": "/ansar-times", "destination": "/seo/ansar-times.html" },
      { "source": "/ansar-family", "destination": "/seo/ansar-family.html" },
      { "source": "/alumni", "destination": "/seo/alumni.html" },
      { "source": "/achievements", "destination": "/seo/achievements.html" },
      { "source": "/ansar-media-production", "destination": "/seo/ansar-media-production.html" },
      { "source": "/sop", "destination": "/seo/sop.html" },
      { "source": "/school-policies", "destination": "/seo/school-policies.html" },
      { "source": "/mandatory-public-disclosure", "destination": "/seo/mandatory-public-disclosure.html" }
    ]
  }
}
