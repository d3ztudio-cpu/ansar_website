{
  "functions": { "source": "functions" },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": false,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/science-labs{,/**}",
        "destination": "/learning/advanced-labs",
        "type": 301
      },
      {
        "source": "/learning/wi-fi-learning-environment{,/**}",
        "destination": "/learning/smart-classrooms",
        "type": 301
      },
      {
        "source": "/events/6",
        "destination": "/events",
        "type": 301
      },
      {
        "source": "/staff{,/**}",
        "destination": "/about",
        "type": 301
      },
      {
        "source": "/leadership{,/**}",
        "destination": "/#leadership",
        "type": 301
      },
      {
        "source": "/event{,/**}",
        "destination": "/events",
        "type": 301
      },
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/index-new.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/about.html",
        "destination": "/about",
        "type": 301
      },
      {
        "source": "/about-new.html",
        "destination": "/about",
        "type": 301
      },
      {
        "source": "/academics.html",
        "destination": "/academics",
        "type": 301
      },
      {
        "source": "/admission.html",
        "destination": "/admission",
        "type": 301
      },
      {
        "source": "/admission-new.html",
        "destination": "/admission",
        "type": 301
      },
      {
        "source": "/contact.html",
        "destination": "/contact",
        "type": 301
      },
      {
        "source": "/contact-new.html",
        "destination": "/contact",
        "type": 301
      },
      {
        "source": "/gallery-page.html",
        "destination": "/gallery",
        "type": 301
      },
      {
        "source": "/events.html",
        "destination": "/events",
        "type": 301
      },
      {
        "source": "/events-page.html",
        "destination": "/events",
        "type": 301
      },
      {
        "source": "/news.html",
        "destination": "/news",
        "type": 301
      },
      {
        "source": "/news-page.html",
        "destination": "/news",
        "type": 301
      },
      {
        "source": "/news-detail.html",
        "destination": "/news",
        "type": 301
      },
      {
        "source": "/admin.html",
        "destination": "/admin",
        "type": 301
      },
      {
        "source": "/gallery.html",
        "destination": "/gallery",
        "type": 301
      },
      {
        "source": "/achievements.html",
        "destination": "/achievements",
        "type": 301
      },
      {
        "source": "/library.html",
        "destination": "/library",
        "type": 301
      },
      {
        "source": "/library/quiz.html",
        "destination": "/ansar-media-production/add-ons/online-quiz",
        "type": 301
      },
      {
        "source": "/library/quiz",
        "destination": "/ansar-media-production/add-ons/online-quiz",
        "type": 301
      },
      {
        "source": "/atl.html",
        "destination": "/atl",
        "type": 301
      },
      {
        "source": "/alumni.html",
        "destination": "/alumni",
        "type": 301
      },
      {
        "source": "/ansar-times.html",
        "destination": "/ansar-times",
        "type": 301
      },
      {
        "source": "/ansar-sprouts.html",
        "destination": "/ansar-sprouts",
        "type": 301
      },
      {
        "source": "/sports",
        "destination": "/sports-page",
        "type": 301
      },
      {
        "source": "/sports.html",
        "destination": "/sports-page",
        "type": 301
      },
      {
        "source": "/staff.html",
        "destination": "/about",
        "type": 301
      },
      {
        "source": "/leadership.html",
        "destination": "/#leadership",
        "type": 301
      },
      {
        "source": "/more.html",
        "destination": "/about",
        "type": 301
      },
      {
        "source": "/page.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/:path*/",
        "destination": "/:path",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/@(index.html|404.html|sw.js|version.json|manifest.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/learning/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/ansar-sprouts/activities/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/field-trips/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/alumni/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/ansar-media-production/add-ons/online-quiz",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/@(news|events|achievements|sports-achievements)/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/@(about|academics|admission|contact|gallery|news|events|achievements|sports-page|atl|library|ansar-sprouts|field-trips|counseling|extension-services|life-at-ansar|ansar-times|ansar-family|alumni|ansar-media-production|sop|school-policies|mandatory-public-disclosure)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/seo/**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(avif|webp|png|jpg|jpeg|gif|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "**/*.@(pdf|xlsx|xls)",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, follow, noarchive"
          }
        ]
      },
      {
        "source": "/admin{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow, noarchive"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/admin{,/**}",
        "destination": "/index.html"
      },
      {
        "source": "/learning/cctv-enabled-safety",
        "destination": "/index.html"
      },
      {
        "source": "/learning/smart-classrooms",
        "destination": "/index.html"
      },
      {
        "source": "/learning/qualified-support-staff",
        "destination": "/index.html"
      },
      {
        "source": "/learning/special-play-area",
        "destination": "/index.html"
      },
      {
        "source": "/learning/advanced-labs",
        "destination": "/index.html"
      },
      {
        "source": "/learning/multi-sports-play-area",
        "destination": "/index.html"
      },
      {
        "source": "/learning/safe-school-transport",
        "destination": "/index.html"
      },
      {
        "source": "/learning/healthy-dining-spaces",
        "destination": "/index.html"
      },
      {
        "source": "/@(news|events|achievements|sports-achievements)/**",
        "destination": "/index.html"
      },
      {
        "source": "/ansar-times/:editionId",
        "destination": "/index.html"
      },
      {
        "source": "/ansar-media-production/add-ons/online-quiz{,/**}",
        "destination": "/index.html"
      },
      {
        "source": "/ansar-sprouts/activities/:id",
        "destination": "/index.html"
      },
      {
        "source": "/field-trips/:id",
        "destination": "/index.html"
      },
      {
        "source": "/alumni/:section/:index",
        "destination": "/index.html"
      },
      {
        "source": "/forms",
        "destination": "/index.html"
      },
      { "source": "/about", "destination": "/index.html" },
      { "source": "/academics", "destination": "/index.html" },
      { "source": "/admission", "destination": "/index.html" },
      { "source": "/news", "destination": "/index.html" },
      { "source": "/events", "destination": "/index.html" },
      { "source": "/contact", "destination": "/index.html" },
      { "source": "/gallery", "destination": "/index.html" },
      { "source": "/sports-page", "destination": "/index.html" },
      { "source": "/atl", "destination": "/index.html" },
      { "source": "/library", "destination": "/index.html" },
      { "source": "/ansar-sprouts", "destination": "/index.html" },
      { "source": "/field-trips", "destination": "/index.html" },
      { "source": "/counseling", "destination": "/index.html" },
      {
        "source": "/extension-services",
        "destination": "/index.html"
      },
      { "source": "/life-at-ansar", "destination": "/index.html" },
      { "source": "/ansar-times", "destination": "/index.html" },
      { "source": "/ansar-family", "destination": "/index.html" },
      { "source": "/alumni", "destination": "/index.html" },
      { "source": "/achievements", "destination": "/index.html" },
      {
        "source": "/ansar-media-production",
        "destination": "/index.html"
      },
      { "source": "/sop", "destination": "/index.html" },
      {
        "source": "/school-policies",
        "destination": "/index.html"
      },
      {
        "source": "/mandatory-public-disclosure",
        "destination": "/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
