rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Site admins who are allowed to save library, events, news, and media.
    function isAdmin() {
      return request.auth != null && request.auth.token.email != null &&
        request.auth.token.email in [
          'd3ztudio@gmail.com',
          'ansarmedia@ansarschool.in',
          'ansarschooloffice@gmail.com',
          'aesmedia2025@gmail.com'
        ];
    }

    function isLibraryAdmin() {
      return request.auth != null && request.auth.token.email != null &&
        request.auth.token.email == 'aeslibrary@ansarschool.in' &&
        request.auth.token.email_verified == true;
    }

    function canManageLibrary() {
      return isAdmin() || isLibraryAdmin();
    }

    function isLibraryMediaAdmin() {
      return isAdmin() && request.auth.token.email in [
        'd3ztudio@gmail.com',
        'ansarmedia@ansarschool.in',
        'ansarschooloffice@gmail.com',
        'aesmedia2025@gmail.com'
      ];
    }

    match /learning-features/{featureId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Library media (images + PDFs) live only on the school's Hostinger storage
    // (public_html/UPLOADS, served at upload.ansarschool.in). Firebase Storage
    // holds no school media — the upload endpoint is the library-image path.
    match /library/{itemId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth.token.email in [
        'd3ztudio@gmail.com',
        'ansarmedia@ansarschool.in',
        'ansarschooloffice@gmail.com',
        'aesmedia2025@gmail.com'
      ];
      allow delete: if request.auth.token.email in [
        'd3ztudio@gmail.com',
        'ansarmedia@ansarschool.in',
        'ansarschooloffice@gmail.com',
        'aesmedia2025@gmail.com'
      ];
    }
  }
}
