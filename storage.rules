rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.email != null &&
        request.auth.token.email in [
          'd3ztudio@gmail.com',
          'ansarmedia@ansarschool.in',
          'shafeeqpulikkal32@gmail.com',
          'ansarschooloffice@gmail.com',
          'aesmedia2025@gmail.com'
        ];
    }

    function isLibraryAdmin() {
      return request.auth != null && request.auth.token.email != null &&
        request.auth.token.email == 'aeslibrary@ansarschool.in' &&
        request.auth.token.email_verified == true;
    }

    function canManageLibrary() {
      return isAdmin() || isLibraryAdmin();
    }

    match /learning-features/{featureId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /library/{itemId}/{fileName} {
      allow read: if true;
      allow create, update: if canManageLibrary()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if canManageLibrary();
    }
  }
}
